{
  "name": "@traco/sdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "infra:up": "docker compose --env-file .env.local -f docker-compose.local.yml up -d",
    "infra:down": "docker compose --env-file .env.local -f docker-compose.local.yml down",
    "infra:logs": "docker compose --env-file .env.local -f docker-compose.local.yml logs -f",
    "seed:test-courses": "tsx scripts/seed-test-courses.ts",
    "seed:test-sdr-config": "tsx scripts/seed-test-sdr-config.ts",
    "seed:training": "tsx scripts/seed-official-training.ts",
    "seed:pilot-course": "tsx scripts/seed-pilot-implantodontia.ts",
    "queue:cleanup:dev": "tsx scripts/cleanup-development-queue.ts --confirm-development-cleanup",
    "queue:retry:dev": "tsx scripts/retry-development-conversation.ts",
    "conversation:close:dev": "tsx scripts/close-development-conversation.ts --confirm-development-close",
    "diagnose:conversation:dev": "tsx scripts/diagnose-development-conversation.ts",
    "conversation:repair-handoff:dev": "tsx scripts/repair-development-handoff-answer.ts --confirm-development-repair",
    "kommo:inspect": "tsx scripts/inspect-kommo.ts",
    "kommo:test-lead": "tsx scripts/create-kommo-test-lead.ts",
    "kommo:provision:dev": "tsx scripts/provision-kommo-homologation.ts --confirm-kommo-homologation",
    "kommo:seed-config:dev": "tsx scripts/seed-kommo-development-config.ts --confirm-development-kommo-config",
    "alerts:test-email": "tsx scripts/test-critical-email.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "start:retention": "node dist/retention.js",
    "dev:retention": "tsx src/retention.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "openai": "^6.49.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
