# Processo HTTP
PORT=10000
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080

# Supabase de desenvolvimento (nunca use uma Secret/service_role no frontend)
SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
# Aceita a Secret key atual (sb_secret_...) ou a service_role legada.
SUPABASE_SERVICE_ROLE_KEY=

# Conector de catálogo da organização (somente no backend)
CATALOG_PROVIDER=http-course-catalog
CATALOG_PROVIDER_NAME=Nome da organização
CATALOG_BASE_URL=https://api-da-organizacao.example
CATALOG_API_KEY=
CATALOG_COURSES_PATH=/functions/v1/wordpress-courses
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_TIMEOUT_MS=10000

# Render Key Value, Redis ou Valkey
REDIS_URL=redis://localhost:6379

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# WAHA
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=

# Conta Resend exclusiva do SDR para falhas técnicas críticas
RESEND_API_KEY=
ALERT_EMAIL_FROM=Robô SDR Traço <sdr@seudominio.com.br>
# Até 10 destinatários, separados por vírgula
ALERT_EMAIL_TO=suporte@seudominio.com.br

# Comportamento do robô
SDR_RESPONSE_DELAY_MS=8000
SDR_CONTEXT_MESSAGE_LIMIT=20
SDR_MAX_RETRIES=3
# Follow-up da matrícula: até 3 mensagens, a cada 4 horas, entre 8h e 20h.
SDR_ENROLLMENT_FOLLOW_UP_INTERVAL_HOURS=4
SDR_ENROLLMENT_FOLLOW_UP_MAX_ATTEMPTS=3
SDR_TIME_ZONE=America/Sao_Paulo
# Desenvolvimento: números autorizados, com DDI, separados por vírgula.
# Exemplo: 5562999999999,5562988888888
SDR_TEST_ALLOWED_PHONE_NUMBERS=

# Clint (somente backend; IDs são UUIDs obtidos na API/conta Clint)
CLINT_API_TOKEN=
CLINT_ORIGIN_ID=
CLINT_NEW_LEAD_STAGE_ID=
CLINT_QUALIFIED_STAGE_ID=
CLINT_INTERESTED_STAGE_ID=
CLINT_NEGOTIATION_STAGE_ID=
CLINT_DATA_COLLECTED_STAGE_ID=
CLINT_AWAITING_HUMAN_STAGE_ID=
CLINT_RESPONSIBLE_USER_ID=
CLINT_HANDOFF_NOTE_FIELD_ID=
CLINT_FIELD_FULL_NAME_ID=
CLINT_FIELD_WHATSAPP_PHONE_ID=
CLINT_FIELD_CPF_ID=
CLINT_FIELD_BIRTH_DATE_ID=
CLINT_FIELD_MARITAL_STATUS_ID=
CLINT_FIELD_NATIONALITY_ID=
CLINT_FIELD_BIRTHPLACE_ID=
CLINT_FIELD_CRO_ID=
CLINT_FIELD_EMAIL_ID=
CLINT_FIELD_ADDRESS_ID=
CLINT_FIELD_DISTRICT_ID=
CLINT_FIELD_POSTAL_CODE_ID=
# Usado pela Edge Function wordpress-courses no Supabase.
CLINT_COURSE_TITLE_FIELD_ID=
